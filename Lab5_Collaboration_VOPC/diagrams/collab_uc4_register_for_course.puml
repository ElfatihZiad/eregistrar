@startuml collab_uc4_register_for_course
!pragma layout smetana
skinparam shadowing false
skinparam object {
  BackgroundColor<<actor>> #FFFFFF
  BackgroundColor<<boundary>> #E3F2FD
  BackgroundColor<<control>> #FFF8E1
  BackgroundColor<<entity>> #E8F5E9
}
title UC4: Register for Course, Collaboration (Communication) Diagram

object "Student" as Student <<actor>>
object "aRegistrationPage" as UI <<boundary>>
object "aRegistrationController" as Ctrl <<control>>
object "aRegistrationValidator" as Validator <<control>>
object "aStudent" as StudentE <<entity>>
object "aSection" as Section <<entity>>
object "aCourse" as Course <<entity>>
object "aRegistration" as Reg <<entity>>

Student --> UI : 1: selectSection(section)
UI --> Ctrl : 2: register(studentId, sectionId)
Ctrl --> Validator : 3: validate(student, section)
Validator --> Section : 3.1: getCourse()
Validator --> Course : 3.2: getPrerequisites()
Validator --> StudentE : 3.3: hasCompleted(prerequisites)
Validator --> Section : 3.4: hasAvailableSeat()
Validator --> StudentE : 3.5: getRegistrations(block)
Ctrl --> Reg : 4: create(student, section)
Ctrl --> Section : 5: decrementAvailableSeats()
Ctrl --> UI : 6: confirmation
UI --> Student : 7: displayConfirmation()

note bottom of Validator
  3.1–3.5 realise business rules
  BR6–BR9. A failure at any step
  aborts the collaboration before
  message 4.
end note

@enduml
