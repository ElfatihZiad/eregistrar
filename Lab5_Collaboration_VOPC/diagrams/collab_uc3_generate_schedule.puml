@startuml collab_uc3_generate_schedule
!pragma layout smetana
skinparam shadowing false
skinparam object {
  BackgroundColor<<actor>> #FFFFFF
  BackgroundColor<<boundary>> #E3F2FD
  BackgroundColor<<control>> #FFF8E1
  BackgroundColor<<entity>> #E8F5E9
}
title UC3: Generate Term Schedule, Collaboration (Communication) Diagram

object "Registrar" as Admin <<actor>>
object "aScheduleGenerationPage" as UI <<boundary>>
object "aScheduleController" as Ctrl <<control>>
object "aScheduleGenerator" as Generator <<control>>
object "anAssignmentConflictChecker" as Checker <<control>>
object "aTerm" as Term <<entity>>
object "aProgram" as Program <<entity>>
object "aCourse" as Course <<entity>>
object "aFaculty" as Faculty <<entity>>
object "aSection" as Section <<entity>>
object "aSchedule" as Schedule <<entity>>

Admin --> UI : 1: requestGeneration(termId)
UI --> Ctrl : 2: generateSchedule(termId, options)
Ctrl --> Term : 3: getBlocksAndEntries()
Ctrl --> Generator : 4: generate(term, options)
Generator --> Program : 4.1: getRequiredCourses(entry, block)
Generator --> Course : 4.2: getLevel() / getPrerequisites()
Generator --> Section : 4.3: create(course, block, capacity)
Generator --> Faculty : 4.4: findQualifiedAndAvailable(course, block)
Generator --> Checker : 4.5: checkAssignment(faculty, section)
Checker --> Faculty : 4.5.1: getAssignments(block)
Generator --> Section : 4.6: assignFaculty(faculty)
Generator --> Schedule : 4.7: create(term, sections, DRAFT)
Ctrl --> UI : 5: draftSchedule + unstaffedCourses
UI --> Admin : 6: displayDraftSchedule()

note bottom of Checker
  4.5 enforces BR5 (no faculty in two
  sections in the same block) and BR6
  (only teachable courses). A conflict
  sends 4.4 back for the next candidate.
end note

@enduml
