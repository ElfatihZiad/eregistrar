@startuml vopc_uc3_generate_schedule
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
title UC3 — Generate Term Schedule — VOPC (View of Participating Classes)

class ScheduleGenerationPage <<boundary>> {
  +displayGenerationForm(terms)
  +submitGeneration(termId, options)
  +displayDraftSchedule(schedule, unstaffed)
}

class ScheduleController <<control>> {
  +getGenerationForm() : GenerationForm
  +generateSchedule(termId, options) : Schedule
  +publishSchedule(scheduleId) : void
}

class ScheduleGenerator <<control>> {
  +generate(term, options) : Schedule
  -determineRequiredCourses(entry, block) : List<Course>
  -placeByLevel(course, entry) : Block
  -selectFaculty(course, block) : Faculty
}

class AssignmentConflictChecker <<control>> {
  +checkAssignment(faculty, section) : ConflictResult
  -isQualified(faculty, course) : boolean
  -isAvailable(faculty, block) : boolean
  -isDoubleBooked(faculty, block) : boolean
}

class Term <<entity>> {
  -termId : Long
  -name : String
  -startDate : LocalDate
  +getBlocks() : List<Block>
  +getActiveEntries() : List<Entry>
}

class Entry <<entity>> {
  -entryId : Long
  -name : String
  -startBlock : int
}

class Program <<entity>> {
  -programId : Long
  -name : String
  +getRequiredCourses(entry, block) : List<Course>
}

class Course <<entity>> {
  -code : String
  -title : String
  -level : int
  +getPrerequisites() : List<Course>
}

class Faculty <<entity>> {
  -facultyId : Long
  -name : String
  -email : String
  +getSpecializations() : List<Specialization>
  +getTeachableCourses() : List<Course>
  +isAvailable(block) : boolean
  +getAssignments(block) : List<Section>
}

class Section <<entity>> {
  -sectionId : Long
  -capacity : int
  -registeredCount : int
  +assignFaculty(faculty) : void
  +isStaffed() : boolean
}

class Schedule <<entity>> {
  -scheduleId : Long
  -status : ScheduleStatus
  -generatedOn : LocalDateTime
  +publish() : void
  +getUnstaffedSections() : List<Section>
}

class Block <<entity>> {
  -blockId : Long
  -sequence : int
}

ScheduleGenerationPage --> ScheduleController : invokes
ScheduleController --> ScheduleGenerator : uses
ScheduleGenerator --> AssignmentConflictChecker : uses
ScheduleGenerator ..> Program : queries
ScheduleGenerator ..> Course : queries
ScheduleGenerator ..> Faculty : queries
ScheduleGenerator --> Section : creates
ScheduleGenerator --> Schedule : creates
AssignmentConflictChecker ..> Faculty : queries

Term "1" -- "1..*" Block : consists of >
Term "1" -- "0..*" Entry : hosts >
Program "1" -- "0..*" Course : requires >
Schedule "1" -- "0..*" Section : contains >
Course "1" -- "0..*" Section : is offered as >
Block "1" -- "0..*" Section : scheduled in >
Faculty "0..1" -- "0..*" Section : teaches >

@enduml
