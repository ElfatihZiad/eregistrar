@startuml architecture_layers
!pragma layout smetana
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor<<client>> #EAF2FB
  BackgroundColor<<presentation>> #E8F5E9
  BackgroundColor<<business>> #FFF8E1
  BackgroundColor<<domain>> #FFFDE7
  BackgroundColor<<data>> #F3E5F5
  BackgroundColor<<external>> #ECEFF1
}
title eRegistrar: High-Level System Architecture (Layered)

rectangle "Client Tier" <<client>> as L0 {
  component "Web Browser\n(desktop / mobile)" as Browser
}

rectangle "Presentation Layer" <<presentation>> as L1 {
  component "Thymeleaf Views\n(server-rendered pages)" as Views
  component "REST API\n(/api/**, JSON)" as RestApi
  component "Spring MVC Controllers\nFacultyController · ScheduleController\nRegistrationController" as Controllers
  component "Spring Security\n(SSO, role-based access)" as Security
}

rectangle "Business Layer: Subsystems" <<business>> as L2 {
  component "Faculty Profile" as SubFaculty
  component "Course & Program\nCatalog" as SubCatalog
  component "Scheduling" as SubSchedule
  component "Registration" as SubRegistration
  component "Notification\nService" as SubNotify
}

rectangle "Domain Model" <<domain>> as L3 {
  component "Faculty · Course · Section\nStudent · Registration · Schedule" as Domain
}

rectangle "Data Access Layer" <<data>> as L4 {
  component "Spring Data JPA\nRepositories" as Repos
  database "eregistrar\n(MySQL / PostgreSQL)" as DB
}

rectangle "External Systems" <<external>> as L5 {
  component "Campus Identity\nProvider (OIDC)" as IdP
  component "Student Information\nSystem (REST)" as SIS
  component "SMTP / Email\nGateway" as SMTP
}

' --- between layers -------------------------------------------------
Browser --> Views  : HTTPS
Browser --> RestApi : HTTPS / JSON
Views --> Controllers
RestApi --> Controllers
Controllers --> Security

L1 --> L2 : service calls
L2 --> L3 : operates on
L3 --> L4 : persisted by
Repos --> DB : JDBC

' --- within the business layer --------------------------------------
SubSchedule --> SubFaculty : qualified &\navailable faculty
SubSchedule --> SubCatalog : course &\nprogram rules
SubRegistration --> SubCatalog : prerequisites
SubRegistration --> SubSchedule : sections &\ncapacity
SubSchedule --> SubNotify
SubRegistration --> SubNotify

' --- out to external systems ----------------------------------------
Security --> IdP : OIDC
SubNotify --> SMTP : SMTP
L2 --> SIS : publish schedule /\nconfirmed registrations

@enduml
