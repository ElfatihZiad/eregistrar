@startuml sd_uc6_register_alternate_flows
skinparam shadowing false
title UC6 — Register for Course (Alternate Flows A1–A4) — Analysis-level Sequence Diagram

actor "Student" as Student
boundary "RegistrationPage\n<<boundary>>" as UI
control "RegistrationController\n<<control>>" as Ctrl
control "RegistrationValidator\n<<control>>" as Validator
entity "Section\n<<entity>>" as Section
entity "Registration\n<<entity>>" as Reg

Student -> UI : select section, confirm registration
activate UI
UI -> Ctrl : register(studentId, sectionId)
activate Ctrl
Ctrl -> Validator : validate(student, section)
activate Validator

alt A1 — prerequisite not met
    Validator --> Ctrl : PrerequisiteNotMet(course)
    Ctrl --> UI : error "Missing prerequisite: <course>"
    UI --> Student : show error, schedule unchanged

else A2 — section full
    Validator --> Ctrl : SectionFull(section)
    Ctrl --> UI : error "Section is full"
    UI --> Student : show error, offer other sections

else A3 — time conflict
    Validator --> Ctrl : TimeConflict(otherSection)
    Ctrl --> UI : error "Conflicts with <other section>"
    UI --> Student : show error and the conflicting section

else A4 — course load exceeded
    Validator --> Ctrl : CourseLoadExceeded(limit)
    Ctrl --> UI : error "Limit of <n> courses for this block"
    UI --> Student : show error

else basic flow — all rules pass
    Validator --> Ctrl : valid
    deactivate Validator
    Ctrl -> Reg : create(student, section)
    activate Reg
    Reg --> Ctrl : registration
    deactivate Reg
    Ctrl -> Section : decrementAvailableSeats()
    activate Section
    alt seat taken concurrently (optimistic lock failure)
        Section --> Ctrl : OptimisticLockException
        Ctrl --> UI : error "Section is full"
        UI --> Student : show error
    else seat secured
        Section --> Ctrl : ok
        deactivate Section
        Ctrl --> UI : confirmation
        UI --> Student : display confirmation
    end
end
deactivate Ctrl
deactivate UI

note across
  In every alternate flow the transaction is rolled back:
  no registration is created and no seat is consumed.
end note

@enduml
