@startuml usecase_eregistrar
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
title eRegistrar: Use Case Model

actor "Student" as Student
actor "Faculty" as Faculty
actor "Registrar\n(Administrator)" as Admin

rectangle "eRegistrar" {
  usecase "UC1\nManage Faculty Profile" as UC1
  usecase "UC2\nManage Course Catalog" as UC2
  usecase "UC3\nGenerate Term Schedule" as UC3
  usecase "UC4\nRegister for Course" as UC4
  usecase "UC5\nDrop Course" as UC5
  usecase "UC6\nView Schedule" as UC6
}

Faculty --> UC1
Faculty --> UC6

Admin --> UC1
Admin --> UC2
Admin --> UC3

Student --> UC4
Student --> UC5
Student --> UC6

UC3 ..> UC1 : <<uses>>
UC3 ..> UC2 : <<uses>>
UC4 ..> UC3 : <<uses>>
UC5 ..> UC4 : <<extends>>

@enduml
